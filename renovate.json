{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "Paused: lsd-core is in maintenance while lsd-mono replaces it. Set enabled back to true to resume updates.",
  "enabled": false,
  "extends": [
    "config:base",
    ":dependencyDashboard"
  ],
  "lockFileMaintenance": {
    "enabled": true
  },
  "timezone": "Europe/London",
  "schedule": ["* 0-8 * * 1"],
  "minimumReleaseAge": "3 days",
  "osvVulnerabilityAlerts": true,
  "vulnerabilityAlerts": {
    "enabled": true,
    "description": "Security fixes stay fix(deps) so they still release: any time, no waiting, not grouped.",
    "commitMessagePrefix": "fix(deps): ",
    "schedule": ["at any time"],
    "minimumReleaseAge": null,
    "groupName": null,
    "addLabels": ["security"]
  },
  "labels": [
    "dependencies"
  ],
  "addLabels": [
    "{{updateType}}"
  ],
  "rebaseWhen": "behind-base-branch",
  "packageRules": [
    {
      "matchUpdateTypes": [
        "patch",
        "minor"
      ],
      "automerge": true,
      "automergeType": "pr"
    },
    {
      "matchUpdateTypes": [
        "major"
      ],
      "automerge": false
    },
    {
      "description": "One weekly pull request for minor, patch and digest updates. The groups below keep their own pull requests. Majors stay one pull request each.",
      "matchUpdateTypes": ["minor", "patch", "digest"],
      "groupName": "all non-major dependencies",
      "groupSlug": "all-minor-patch"
    },
    {
      "matchPackagePatterns": [
        "org.jetbrains.kotlin"
      ],
      "groupName": "kotlin dependencies"
    },
    {
      "description": "Production dependencies: build(deps), which releases nothing by itself. They go out with the next feat/fix release (Maven Central publishing limits). Security fixes stay fix(deps) via vulnerabilityAlerts.",
      "matchPackagePatterns": [
        "org.jetbrains.kotlin*",
        "org.jetbrains.dokka*",
        "org.jetbrains.kotlinx*",
        "com.github.jknack*",
        "net.sourceforge.plantuml*",
        "io.github.lsd-consulting*"
      ],
      "commitMessagePrefix": "build(deps): "
    },
    {
      "matchManagers": [
        "github-actions"
      ],
      "commitMessagePrefix": "ci(deps): "
    }
  ],
  "commitMessagePrefix": "chore(deps): "
}
